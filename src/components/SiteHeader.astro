---
const path = Astro.url.pathname
const links = [
  { href: '/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
]
---

<header class="flex items-center justify-between py-10 text-sm">
  <a href="/" class="font-medium">Salmanul Faris</a>
  <nav class="flex gap-6">
    {
      links.map(({ href, label }) => {
        const active = href === '/' ? path === '/' : path.startsWith(href)
        return (
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class:list={['transition-colors hover:text-fg', active ? 'text-fg' : 'text-muted']}
          >
            {label}
          </a>
        )
      })
    }
  </nav>
</header>
