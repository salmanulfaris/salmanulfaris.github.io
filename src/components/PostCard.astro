---
import type { CollectionEntry } from 'astro:content'
import { formatDate, readingTime } from '@/lib/posts'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, date, tags, draft } = post.data
---

<article class="group relative -mx-4 rounded-xl px-4 py-5 transition-colors hover:bg-white/5">
  <div class="flex items-center gap-2 text-xs text-slate-400">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span>·</span>
    <span>{readingTime(post.body)}</span>
    {draft && <span class="rounded-full bg-amber-400/20 px-2 text-amber-300">draft</span>}
  </div>
  <h2 class="mt-1 text-xl font-bold tracking-tight">
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">{title}</a>
  </h2>
  <p class="mt-1 text-sm leading-6 text-slate-300">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full border border-slate-600 px-3 py-0.5 text-xs">{tag}</span>
        ))}
      </div>
    )
  }
</article>
