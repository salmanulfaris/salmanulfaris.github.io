---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@/lib/posts'

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

<ul class="divide-y divide-line">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="group flex items-baseline justify-between gap-6 py-4">
          <span class="underline-offset-4 group-hover:underline">
            {post.data.title}
            {post.data.draft && <span class="ml-2 text-xs text-muted">(draft)</span>}
          </span>
          <time datetime={post.data.date.toISOString()} class="shrink-0 text-sm tabular-nums text-muted">
            {formatDate(post.data.date)}
          </time>
        </a>
      </li>
    ))
  }
</ul>
