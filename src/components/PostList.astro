---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { formatDate } from '@/lib/posts'

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

<ul class="divide-y divide-line">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`} class="group flex items-center gap-4 py-4">
          {post.data.cover ? (
            <Image
              src={post.data.cover}
              alt=""
              width={160}
              height={106}
              class="aspect-[3/2] w-20 shrink-0 rounded-md border border-line object-cover"
            />
          ) : (
            <div class="aspect-[3/2] w-20 shrink-0 rounded-md border border-line bg-subtle" aria-hidden="true" />
          )}
          <div class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <span class="underline-offset-4 group-hover:underline">
              {post.data.title}
              {post.data.draft && <span class="ml-2 text-xs text-muted">(draft)</span>}
            </span>
            <time datetime={post.data.date.toISOString()} class="shrink-0 text-sm tabular-nums text-muted">
              {formatDate(post.data.date)}
            </time>
          </div>
        </a>
      </li>
    ))
  }
</ul>
