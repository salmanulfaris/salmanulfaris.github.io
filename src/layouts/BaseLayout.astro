---
import '@fontsource-variable/inter'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import '@/styles/global.css'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '@/consts'

interface Props {
  title?: string
  description?: string
  type?: 'website' | 'article'
  image?: ImageMetadata
}

const { title, description = SITE_DESCRIPTION, type = 'website', image } = Astro.props
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE
const canonical = new URL(Astro.url.pathname, Astro.site)
// Link-preview image: the post's cover (as a 1200px JPEG, which every platform supports) or the profile photo
const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.site)
  : new URL('/img/profile-picture-salmanulfaris.jpg', Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@salman_faris_1" />

    <!-- Set the theme before first paint to avoid a flash of the wrong colors -->
    <script is:inline>
      ;(function () {
        let theme
        try {
          theme = localStorage.getItem('theme')
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        document.documentElement.dataset.theme = theme
      })()
    </script>

    <!-- Google Analytics, production builds only so local visits aren't counted -->
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3QEF5JX4GE" />
          <script is:inline>
            window.dataLayer = window.dataLayer || []
            function gtag() {
              dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', 'G-3QEF5JX4GE')
          </script>
        </>
      )
    }
  </head>
  <body>
    <div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6">
      <SiteHeader />
      <main class="flex-1 pb-24">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
