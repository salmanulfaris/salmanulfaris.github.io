---
import '@fontsource-variable/inter'
import '@/styles/global.css'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '@/consts'

interface Props {
  title?: string
  description?: string
  type?: 'website' | 'article'
}

const { title, description = SITE_DESCRIPTION, type = 'website' } = Astro.props
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE
const canonical = new URL(Astro.url.pathname, Astro.site)
const image = new URL('/img/profile-picture-salmanulfaris.jpg', Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@salman_faris_1" />
  </head>
  <body>
    <div class="mx-auto flex min-h-dvh max-w-2xl flex-col px-6">
      <SiteHeader />
      <main class="flex-1 pb-24">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
