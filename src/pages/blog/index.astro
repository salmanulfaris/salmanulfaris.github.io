---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/PostList.astro'
import { getPosts } from '@/lib/posts'

const posts = await getPosts()

// Group posts by year, newest year first
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))]
---

<BaseLayout title="Blog" description="Notes and articles by Salmanul Faris.">
  <h1 class="pt-8 text-2xl font-semibold tracking-tight">Blog</h1>
  <p class="mt-1 text-muted">Notes on software engineering, data science and things I'm learning.</p>

  {posts.length === 0 && <p class="mt-12 text-muted">Nothing here yet.</p>}

  {
    years.map((year) => (
      <section class="mt-12">
        <h2 class="text-sm font-medium text-muted">{year}</h2>
        <div class="mt-2">
          <PostList posts={posts.filter((p) => p.data.date.getFullYear() === year)} />
        </div>
      </section>
    ))
  }
</BaseLayout>
