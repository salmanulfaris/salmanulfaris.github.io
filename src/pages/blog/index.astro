---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import PostCard from '@/components/PostCard.astro'
import { getPosts } from '@/lib/posts'

const posts = await getPosts()
---

<BaseLayout title="Blog" description="Notes and articles by Salmanul Faris.">
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-6 pb-32">
    <h1 class="mt-8 text-4xl font-black tracking-tight md:text-6xl">Blog</h1>
    <p class="mt-4 text-slate-300">Notes on software engineering, data science and things I'm learning.</p>

    <div class="mt-12">
      {posts.length === 0 ? <p class="text-slate-400">No posts yet.</p> : posts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
</BaseLayout>
