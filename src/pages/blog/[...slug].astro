---
import { render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import { getPosts, formatDate, readingTime } from '@/lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { title, description, date, updated, tags } = post.data
const { Content } = await render(post)
---

<BaseLayout title={title} description={description} type="article">
  <SiteHeader />
  <main class="mx-auto max-w-3xl px-6 pb-32">
    <article>
      <header class="mt-8 border-b border-slate-800 pb-8">
        <div class="flex flex-wrap items-center gap-2 text-sm text-slate-400">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span>·</span>
          <span>{readingTime(post.body)}</span>
          {updated && <span>· Updated {formatDate(updated)}</span>}
        </div>
        <h1 class="mt-3 text-3xl font-black tracking-tight md:text-5xl">{title}</h1>
        <p class="mt-4 text-lg text-slate-300">{description}</p>
        {
          tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="rounded-full border border-slate-600 px-3 py-0.5 text-xs">{tag}</span>
              ))}
            </div>
          )
        }
      </header>

      <div
        class="prose prose-invert mt-10 max-w-none prose-headings:tracking-tight prose-a:text-cyan-300 prose-pre:border prose-pre:border-slate-800 prose-img:rounded-xl prose-code:before:content-none prose-code:after:content-none prose-code:rounded prose-code:bg-white/10 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal"
      >
        <Content />
      </div>
    </article>

    <a href="/blog/" class="mt-16 inline-block text-sm text-slate-400 transition-colors hover:text-white">
      ← All posts
    </a>
  </main>
</BaseLayout>
