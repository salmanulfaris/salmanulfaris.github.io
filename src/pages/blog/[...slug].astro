---
import { render } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPosts, formatDate, readingTime } from '@/lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { title, description, date, updated, tags, cover, coverAlt } = post.data
const { Content } = await render(post)
---

<BaseLayout title={title} description={description} type="article" image={cover}>
  <article class="pt-8">
    <header>
      <h1 class="text-3xl font-semibold leading-tight tracking-tight text-balance">{title}</h1>
      <p class="mt-3 text-sm text-muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="mx-1.5">·</span>
        {readingTime(post.body)}
        {updated && <span> · Updated {formatDate(updated)}</span>}
      </p>
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt}
          widths={[672, 1344]}
          sizes="(min-width: 720px) 672px, 100vw"
          loading="eager"
          class="mt-8 aspect-[1200/630] w-full rounded-lg border border-line object-cover"
        />
      )
    }

    <div
      class="prose mt-10 max-w-none leading-7 prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-xl prose-h3:text-lg prose-a:underline-offset-4 prose-a:decoration-line hover:prose-a:decoration-current prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-muted prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-lg prose-pre:border prose-pre:border-line prose-pre:text-[13px] prose-img:rounded-lg [&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-subtle [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:text-[0.875em]"
    >
      <Content />
    </div>

    {
      tags.length > 0 && (
        <p class="mt-12 text-sm text-muted">
          Tagged {tags.map((tag, i) => <>{i > 0 && ', '}<span class="text-fg">{tag}</span></>)}
        </p>
      )
    }
  </article>

  <a href="/blog/" class="mt-12 inline-block text-sm text-muted transition-colors hover:text-fg">← All posts</a>
</BaseLayout>

<script>
  // Copy buttons on API request blocks
  document.querySelectorAll<HTMLButtonElement>('.api-copy').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '')
        button.textContent = 'Copied'
      } catch {
        button.textContent = 'Failed'
      }
      setTimeout(() => (button.textContent = 'Copy'), 1500)
    })
  })
</script>
