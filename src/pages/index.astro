---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/PostList.astro'
import { getPosts } from '@/lib/posts'
import { SOCIALS } from '@/consts'

const posts = (await getPosts()).slice(0, 5)

const skills = [
  { name: 'Languages', items: ['Java', 'Python', 'JavaScript', 'PHP', 'Bash', 'SQL'] },
  { name: 'Frameworks', items: ['Laravel', 'Vue', 'Flask', 'LangChain', 'scikit-learn'] },
  { name: 'Platforms', items: ['AWS', 'DigitalOcean', 'Azure'] },
  { name: 'Databases', items: ['MySQL', 'SQLite', 'Firestore', 'MongoDB'] },
]

const education = [
  { subject: 'BS in Data Science and Applications', school: 'IIT Madras', year: '2021 – Present' },
  { subject: 'Diploma in Programming', school: 'IIT Madras', year: '2024' },
  { subject: 'Diploma in Data Science', school: 'IIT Madras', year: '2023' },
  { subject: 'Diploma in Electronics and Communication', school: 'M-DIT Polytechnic College, Kerala', year: '2017 – 2020' },
]
---

<BaseLayout>
  <section class="pt-8">
    <img
      src="/img/profile-picture-salmanulfaris.jpg"
      alt="Salmanul Faris"
      width="64"
      height="64"
      class="size-16 rounded-full object-cover"
    />
    <h1 class="mt-6 text-2xl font-semibold tracking-tight">Salmanul Faris</h1>
    <p class="mt-1 text-muted">Software Engineer · Data Scientist</p>

    <div class="mt-6 space-y-4 leading-7">
      <p>
        I'm a software engineer and data scientist with 5+ years of experience building full-stack web apps and
        solving real-world problems with data. I mostly work with Laravel, Vue, Python and LangChain.
      </p>
      <p>
        I'm currently pursuing the BS degree in Data Science at IIT Madras. I enjoy building scalable systems that
        combine solid engineering with data-driven insight.
      </p>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        SOCIALS.map(({ label, href }) => (
          <a href={href} target="_blank" rel="noopener" class="underline decoration-line underline-offset-4 transition-colors hover:decoration-fg">
            {label} ↗
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-20">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-medium text-muted">Writing</h2>
      <a href="/blog/" class="text-sm text-muted transition-colors hover:text-fg">All posts →</a>
    </div>
    <div class="mt-2">
      {posts.length > 0 ? <PostList posts={posts} /> : <p class="py-4 text-muted">Nothing here yet.</p>}
    </div>
  </section>

  <section class="mt-20">
    <h2 class="text-sm font-medium text-muted">Skills</h2>
    <dl class="mt-4 space-y-3">
      {
        skills.map((group) => (
          <div class="grid gap-1 sm:grid-cols-[8rem_1fr]">
            <dt class="text-sm text-muted">{group.name}</dt>
            <dd>{group.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mt-20">
    <h2 class="text-sm font-medium text-muted">Education</h2>
    <ul class="mt-4 space-y-5">
      {
        education.map((e) => (
          <li class="flex items-baseline justify-between gap-6">
            <div>
              <p>{e.subject}</p>
              <p class="text-sm text-muted">{e.school}</p>
            </div>
            <span class="shrink-0 text-sm tabular-nums text-muted">{e.year}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
