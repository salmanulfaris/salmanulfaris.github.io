---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/PostList.astro'
import { getPosts } from '@/lib/posts'
import { SOCIALS } from '@/consts'

const posts = (await getPosts()).slice(0, 5)

const projects = [
  {
    name: 'QuizPractice.space',
    tagline: 'Exam practice platform',
    links: [{ label: 'quizpractice.space', href: 'https://quizpractice.space' }],
    stack: ['Laravel', 'Vue 3', 'Inertia.js', 'MySQL', 'Python', 'Linux'],
    points: [
      'A web app for IIT Madras BS students to practice past question papers in an exam-like setup, with question data extracted from PDFs automatically.',
      'Grew to 15,000+ users and 1 million+ site visits.',
      'Added a discussion panel and community solutions, contributed by students or an AI bot, plus LLM-based content generation.',
    ],
  },
  {
    name: 'sql-mcp',
    tagline: 'MCP server for AI agents',
    links: [
      { label: 'GitHub', href: 'https://github.com/salmanulfaris/sql-mcp' },
      { label: 'npm', href: 'https://www.npmjs.com/package/@salmanulfaris/sql-mcp' },
    ],
    stack: ['TypeScript', 'Node.js', 'MySQL', 'PostgreSQL', 'SQL Server', 'SQLite'],
    points: [
      'An open-source MCP server that connects AI agents like Claude Desktop, Cursor and Windsurf directly to a live database.',
      'Gives agents real schema and data access, with read-only mode by default and an explicit opt-in for write operations.',
      'Published on npm and runs with zero install through npx.',
    ],
  },
  {
    name: 'easyresize.photos',
    tagline: 'AI photo specification tool',
    links: [{ label: 'easyresize.photos', href: 'https://easyresize.photos' }],
    stack: ['Nuxt 4', 'TypeScript', 'LangGraph', 'ONNX Runtime', 'SQLite'],
    points: [
      'A full-stack web app that turns a plain request like “passport photo for my UAE visa” into a correctly sized and formatted image.',
      'An agentic AI loop (LangGraph ReAct) that can switch between Anthropic and Mistral models. Every result is checked by separate code, so failed requirements trigger an automatic retry.',
      'Privacy-first: the model only receives measured properties like size, format and DPI, never the image itself unless the user allows it.',
      'Background removal (U²-Net) and face detection (YuNet) run on device with ONNX Runtime instead of external APIs.',
    ],
  },
]

const experience = [
  {
    role: 'Software Developer',
    company: 'Hesabe Company for Electronic Payments',
    location: 'Kuwait',
    period: 'Mar 2025 – Present',
    points: [
      'Led the integration of KNET, MPGS, Cybersource and recurring payment systems, making sure every transaction is processed securely and reliably.',
      'Built digital wallet support for Apple Pay, Samsung Pay and Google Pay, including tokenization and secure authentication flows.',
      'Designed and developed RESTful APIs for merchant integrations, transaction processing and real-time payment status updates.',
      'Built reporting and reconciliation tools to track transactions, settlements and performance.',
      'Carried out risk checks and fraud monitoring, improving transaction approval rates while keeping the platform secure and compliant.',
      'Helped build third-party plugins and SDKs in PHP, JavaScript and Python, making it faster for merchants and developers to integrate.',
    ],
  },
  {
    role: 'Full Stack Engineer',
    company: 'Sabsah Hyper',
    location: 'Kuwait',
    period: 'Jul 2022 – Mar 2025',
    points: [
      'Developed and maintained software that fully digitized company operations and made daily workflows much more efficient.',
      'Reduced costs and supported business growth by automating inventory management and accounting processes.',
      'Designed and built HR software with direct integration to biometric attendance hardware.',
      'Integrated Meta Business APIs to improve and streamline several business solutions.',
    ],
  },
  {
    role: 'Full Stack Developer',
    company: 'Freelance',
    location: 'Remote',
    period: 'Sep 2018 – Jun 2022',
    points: [
      'Designed and built custom web applications for restaurants, contract-based companies and non-profit organizations.',
      'Delivered tailored accounting software to six clients, with 100% client satisfaction thanks to simple and efficient systems.',
    ],
  },
]
---

<BaseLayout>
  <section class="pt-8">
    <img
      src="/img/profile-picture-salmanulfaris.jpg"
      alt="Salmanul Faris"
      width="64"
      height="64"
      class="size-16 rounded-full object-cover"
    />
    <h1 class="mt-6 text-2xl font-semibold tracking-tight">Salmanul Faris</h1>
    <p class="mt-1 text-muted">Software Developer · FinTech · Kuwait</p>

    <div class="mt-6 space-y-4 leading-7">
      <p>
        I'm a software developer with around 6 years of experience, currently focused on FinTech and payment systems
        in Kuwait. I build and maintain payment gateway integrations (KNET, MPGS, Cybersource), digital wallets like
        Apple Pay, Samsung Pay and Google Pay, local payment methods, BNPL, and tokenized recurring billing.
      </p>
      <p>
        I also build APIs, SDKs and plugins that help merchants and developers integrate faster. My work is mostly
        backend, in PHP, JavaScript, TypeScript, Python and SQL, with a focus on secure, PCI-compliant transaction
        flows, reconciliation and reliable production systems.
      </p>
    </div>

    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        SOCIALS.map(({ label, href }) => (
          <a href={href} target="_blank" rel="noopener" class="underline decoration-line underline-offset-4 transition-colors hover:decoration-fg">
            {label} ↗
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-20">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-medium text-muted">Writing</h2>
      <a href="/blog/" class="text-sm text-muted transition-colors hover:text-fg">All posts →</a>
    </div>
    <div class="mt-2">
      {posts.length > 0 ? <PostList posts={posts} /> : <p class="py-4 text-muted">Nothing here yet.</p>}
    </div>
  </section>

  <section class="mt-20">
    <h2 class="text-sm font-medium text-muted">Projects</h2>
    <ol class="mt-4 space-y-10">
      {
        projects.map((project) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p>
                <span class="font-medium">{project.name}</span>
                <span class="text-muted"> · {project.tagline}</span>
              </p>
              <span class="flex gap-4 text-sm">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener"
                    class="text-muted underline decoration-line underline-offset-4 transition-colors hover:text-fg hover:decoration-fg"
                  >
                    {link.label} ↗
                  </a>
                ))}
              </span>
            </div>
            <p class="text-sm text-muted">{project.stack.join(' · ')}</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 leading-7 marker:text-muted">
              {project.points.map((point) => <li>{point}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-20">
    <h2 class="text-sm font-medium text-muted">Experience</h2>
    <ol class="mt-4 space-y-10">
      {
        experience.map((job) => (
          <li>
            <div class="flex items-baseline justify-between gap-6">
              <p class="font-medium">{job.role}</p>
              <span class="shrink-0 text-sm tabular-nums text-muted">{job.period}</span>
            </div>
            <p class="text-sm text-muted">
              {job.company} · {job.location}
            </p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 leading-7 marker:text-muted">
              {job.points.map((point) => <li>{point}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
